{
  "expo": {
    "name": "Autoscope",
    "slug": "autoscope-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Autoscope utilise le Bluetooth pour se connecter au dongle OBD-II du véhicule."
      }
    },
    "android": {
      "package": "com.massandie.autoscope",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Autoscope utilise le Bluetooth pour se connecter au dongle OBD-II du véhicule."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "72201aa0-6b4e-4a28-836d-98637a6caaa1"
      }
    },
    "owner": "massandie"
  }
}
